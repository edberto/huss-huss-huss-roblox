local ReplicatedStorage = game:GetService("ReplicatedStorage")
local JestGlobals = require(ReplicatedStorage.DevPackages.JestGlobals)
local Stats = require(ReplicatedStorage.Shared.Stats)

local describe, expect, it = JestGlobals.describe, JestGlobals.expect, JestGlobals.it

describe("Stats", function()
	it("keeps only a combo that beats the record", function()
		local stats = Stats.new()
		Stats.apply(stats, { combo = 40 })
		Stats.apply(stats, { combo = 12 })
		expect(stats.bestCombo).toBe(40)
	end)

	it("adds playtime, dawns per practice, drag-ins and party points", function()
		local stats = Stats.new()
		Stats.apply(stats, { seconds = 90.7, dawnAt = "Gym", draggedIn = 1, partyPoints = 25 })
		Stats.apply(stats, { seconds = 30, dawnAt = "Gym", partyPoints = -5 })
		expect(stats.playtime).toBe(120)
		expect(stats.dawns.Gym).toBe(2)
		expect(stats.dawns.Burgers).toBe(0)
		expect(stats.draggedIn).toBe(1)
		expect(stats.partyPoints).toBe(25)
	end)

	it("reads each category's value", function()
		local stats = Stats.new()
		Stats.apply(stats, { combo = 9, dawnAt = "Burgers" })
		expect(Stats.value(500, stats, "hp")).toBe(500)
		expect(Stats.value(500, stats, "bestCombo")).toBe(9)
		expect(Stats.value(500, stats, "dawns_Burgers")).toBe(1)
		expect(Stats.value(500, stats, "dawns_Gym")).toBe(0)
	end)

	it("formats values for the boards", function()
		expect(Stats.format("hp", 1234567)).toBe("1,234,567")
		expect(Stats.format("bestCombo", 87)).toBe("x87")
		expect(Stats.format("playtime", 3 * 3600 + 25 * 60)).toBe("3h 25m")
		expect(Stats.format("playtime", 610)).toBe("10m")
	end)
end)
